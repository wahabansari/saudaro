# Copy to .env for LOCAL development only. Never commit .env. In production every secret comes from a secret manager.

# --- PostgreSQL (docker-compose service "postgres") ---
POSTGRES_DB=saudaro_marketplace
POSTGRES_USER=admin
# Local-only bootstrap superuser password. The apps NEVER connect as this user.
POSTGRES_PASSWORD=root123

# Superuser URL used ONLY by `npm run db:bootstrap` / `db:migrate` / `database-check` (host-side).
DATABASE_ADMIN_URL=postgres://admin:root123@127.0.0.1:5432/saudaro_marketplace

# Per-service least-privilege role passwords (dev defaults are used when unset; REQUIRED in production).
IDENTITY_SVC_PASSWORD=identity_svc_dev_pass
IDENTITY_MIGRATOR_PASSWORD=identity_migrator_dev_pass
COMPANY_SVC_PASSWORD=company_svc_dev_pass
COMPANY_MIGRATOR_PASSWORD=company_migrator_dev_pass

# --- Token signing keys: generate with `npm run keys:generate` and paste the three lines it prints. ---
# Never commit real keys. AUTH_SIGNING_JWK = identity's private key (signs user access tokens);
# GATEWAY_SIGNING_JWK = gateway's private key (signs service tokens only, marked use:"svc");
# AUTH_PUBLIC_JWKS = both PUBLIC keys, shared by every process for verification.
AUTH_SIGNING_JWK=
GATEWAY_SIGNING_JWK=
AUTH_PUBLIC_JWKS=

# --- API gateway ---
CORS_ORIGINS=http://localhost:5173
GRAPHQL_MAX_DEPTH=10
GRAPHQL_MAX_COMPLEXITY=1000
LOG_LEVEL=info

# --- Observability (optional; tracing is a no-op when unset) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
