{
  "name": "@saudaro/backend",
  "version": "0.1.0",
  "private": true,
  "description": "SAUDARO backend: global B2B import-export marketplace (modular monolith)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:bootstrap": "tsx --env-file-if-exists=.env src/database/scripts/bootstrap.ts",
    "db:generate": "drizzle-kit generate",
    "db:rls:generate": "tsx src/database/policies/generate-rls-migration.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/database/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/database/seeds/run.ts",
    "docs:generate": "tsx src/database/scripts/generate-docs.ts",
    "db:reset:dev": "tsx --env-file-if-exists=.env src/database/scripts/reset-dev.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.0",
    "@fastify/sensible": "^6.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.18.1",
    "embedded-postgres": "^18.0.0-beta.1",
    "eslint": "^9.39.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@18.0.0-beta.15": true
  }
}
