# Copy to .env for local development. NEVER commit .env. Never reuse these values in production;
# production secrets come from a secrets manager / KMS-backed store.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# --- Docker PostgreSQL (docker-compose.yml): database "saudaro_marketplace", superuser admin/root123 ---
# Superuser: used ONLY by `npm run db:bootstrap` (creates the least-privilege roles). Never used by the API:
# a superuser bypasses row-level security, which would defeat tenant isolation.
DATABASE_ADMIN_URL=postgres://admin:root123@127.0.0.1:5432/saudaro_marketplace
POSTGRES_SUPERUSER_PASSWORD=root123

# Runtime application role: NOT superuser, NOT table owner, NOBYPASSRLS. Used by the API.
DATABASE_URL=postgres://saudaro_app:app_dev_pass@127.0.0.1:5432/saudaro_marketplace
# Background worker role (outbox, notifications, scans, matching). NOBYPASSRLS; own narrow policies.
DATABASE_WORKER_URL=postgres://saudaro_worker:worker_dev_pass@127.0.0.1:5432/saudaro_marketplace
# Migration role: owns the schema objects. Used ONLY by `npm run db:migrate` / `npm run db:seed`.
DATABASE_MIGRATION_URL=postgres://saudaro_migrator:migrator_dev_pass@127.0.0.1:5432/saudaro_marketplace

# Passwords assigned to those roles by `npm run db:bootstrap` (must match the URLs above).
BOOTSTRAP_APP_PASSWORD=app_dev_pass
BOOTSTRAP_WORKER_PASSWORD=worker_dev_pass
BOOTSTRAP_MIGRATOR_PASSWORD=migrator_dev_pass
BOOTSTRAP_READONLY_PASSWORD=readonly_dev_pass

# disable | require | verify-full  (use verify-full in production)
DATABASE_SSL=disable
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000
